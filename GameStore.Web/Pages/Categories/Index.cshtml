@page
@model GameStore.Web.Pages.Categories.IndexModel
@using Microsoft.AspNetCore.Authorization
@{
    ViewData["Title"] = "Categories";
    bool isAdminOrManager = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="container mt-4">
    <h1 class="text-primary">Categories</h1>
    <p class="text-muted">Browse available game categories.</p>

    <p>
        <a asp-page="/Games/Index" class="btn btn-outline-secondary">View Games</a>
    </p>

    @if (isAdminOrManager)
    {
        <p>
            <a asp-page="Create" class="btn btn-success">Create New Category</a>
        </p>
    }

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Category[0].Name)</th>
                @if (isAdminOrManager)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Category)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    @if (isAdminOrManager)
                    {
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
